# Public application and Supabase configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only platform configuration
SUPABASE_SERVICE_ROLE_KEY=
APP_ENCRYPTION_KEY=
CHAT_RUN_WORKER_SECRET=

# OpenAI (required only for ALMA AI capabilities)
OPENAI_API_KEY=
ALMA_INSTANT_MODEL=gpt-5.6-luna
ALMA_THINKING_MODEL=gpt-5.6-terra
ALMA_PRO_MODEL=gpt-5.6-sol
ALMA_RESEARCH_PRO_MODEL=gpt-5.5-pro
ALMA_USAGE_ENFORCEMENT_ENABLED=true

# Customer billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OFFICE_MONTHLY=
STRIPE_PRICE_AI_MONTHLY=

# Stripe Connect for accepting customer payments
STRIPE_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Outlook OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# Optional WhatsApp Business
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Optional ALMA Builder services
ALMA_BUILDER_ENGINE_ENABLED=false
ALMA_BUILDER_E2B_TEMPLATE=alma-builder-node-lts
ALMA_BUILDER_GATEWAY_URL=
ALMA_BUILDER_GATEWAY_SIGNING_KEY=
ALMA_BUILDER_WORKER_SECRET=
ALMA_BUILDER_CODEX_MODEL=
ALMA_BUILDER_CODEX_WORKER_ISOLATED=false
ALMA_BUILDER_PREVIEW_HOSTS=e2b.app
E2B_API_KEY=
